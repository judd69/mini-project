# ═══════════════════════════════════════════════════════════════════
# SecureVote — Azure App Service Application Settings Reference
#
# Copy these keys into:
#   Azure Portal → App Service → Configuration → Application Settings
#
# DO NOT commit a real .env file with actual secrets to Git.
# This file is a template only.
# ═══════════════════════════════════════════════════════════════════

# ── Required ────────────────────────────────────────────────────────

# Tells Django to load production settings (instead of development.py)
DJANGO_SETTINGS_MODULE=securevote.settings.production

# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-long-random-secret-key-here

# ── Database (choose one) ────────────────────────────────────────────

# Azure Database for PostgreSQL (Flexible Server)
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/securevote?sslmode=require

# Azure SQL (via pyodbc — requires extra ODBC driver setup on App Service)
# DATABASE_URL=mssql://USERNAME:PASSWORD@HOST:1433/securevote?driver=ODBC+Driver+17+for+SQL+Server

# Leave blank or omit to fall back to SQLite (NOT recommended for production)
# DATABASE_URL=

# ── Set Automatically by Azure ───────────────────────────────────────
# These are set by Azure automatically — do NOT set them manually:
#   WEBSITE_HOSTNAME  (e.g. securevote-app.azurewebsites.net)

# ── GitHub Actions Secret ────────────────────────────────────────────
# In GitHub: Settings → Secrets and variables → Actions → New repository secret
#   Name:  AZURE_WEBAPP_PUBLISH_PROFILE
#   Value: (contents of the publish profile XML downloaded from Azure Portal)
